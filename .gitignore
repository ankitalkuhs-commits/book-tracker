# Virtual environment
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Database
*.db
book_tracker.db
*.db-journal

# Environment variables
.env
.env.local
.env.*
# ...except the local-API override, which holds only a loopback URL. It was ignored, so it
# never existed in a fresh worktree and every agent had to recreate it on a different port;
# the QA harness then refused to run (its own precondition). No secrets belong in this file.
!book-tracker-frontend-stitch/.env.localapi

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Expo/React Native
.expo/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
uploads/notes/*
uploads/profile_pictures/*
!uploads/notes/.gitkeep
!uploads/profile_pictures/.gitkeep

# Backup files
*.bak
*.backup

# Sensitive credentials — never commit these
firebase-service-account.json
*-service-account.json
private_key.pem
public_key.pem
*.pem

# QA screenshot output (qa/screenshots.mjs)
qa/screenshots/

# Editor / Office lock files (e.g. ~$.env.review created when opening .env.review)
~$*

# Claude Code local settings and agent worktrees — machine-specific, never commit
.claude/

# service id written by the migration steps (not a secret, but machine-local)
.render-sg-service-id
